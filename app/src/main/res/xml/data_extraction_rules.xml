<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules configured for Android 12+ (API 31+)
   Prevents unencrypted extraction of local financial database
   Reference: OWASP Mobile M9 Insecure Data Storage
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="keuangan_pribadi.db" />
        <exclude domain="database" path="keuangan_pribadi.db-journal" />
        <exclude domain="database" path="keuangan_pribadi.db-wal" />
        <exclude domain="database" path="keuangan_pribadi.db-shm" />
        <exclude domain="sharedpref" path="keuangan_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="keuangan_pribadi.db" />
        <exclude domain="database" path="keuangan_pribadi.db-journal" />
        <exclude domain="database" path="keuangan_pribadi.db-wal" />
        <exclude domain="database" path="keuangan_pribadi.db-shm" />
        <exclude domain="sharedpref" path="keuangan_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
